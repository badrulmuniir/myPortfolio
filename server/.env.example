# API_Server environment variables. Copy to server/.env and replace every placeholder.
# Never commit server/.env.

# --- Server ---
# API listen port (default 5000)
PORT=5000
# development | production (production hides internal error details)
NODE_ENV=development

# --- Database connection ---
# Use EITHER DATABASE_URL OR the PG* variables. DATABASE_URL takes precedence when both are set.
# Do not put sslmode in DATABASE_URL; use DB_SSL instead.
DATABASE_URL=postgres://portfolio_user:change-me@localhost:5432/portfolio_dev
PGHOST=localhost
# Default 5432
PGPORT=5432
PGUSER=portfolio_user
PGPASSWORD=change-me
PGDATABASE=portfolio_dev
# true enables SSL on every connection (default false)
DB_SSL=false
# Set false only for providers with self-signed certificate chains (default true)
DB_SSL_REJECT_UNAUTHORIZED=true
# Connection pool size, integer 1-100 (default 10)
DB_POOL_MAX=10

# --- Authentication ---
# At least 32 characters. Generate a long random value; never reuse this placeholder.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Whole number of seconds, or a whole number followed by s, m, h or d (default 2h)
JWT_EXPIRES_IN=2h

# --- HTTP ---
# Comma-separated exact Frontend origins allowed by CORS
FRONTEND_URL=http://localhost:5173
# true when running behind exactly one reverse proxy (default false)
TRUST_PROXY=false

# --- Seed_Script only ---
# Valid email for the initial admin account
ADMIN_EMAIL=admin@example.com
# 12 or more characters and at most 72 bytes. Remove from the host environment after seeding.
ADMIN_PASSWORD=replace-with-a-strong-password
# true inserts sample content into an empty database (default false)
SEED_SAMPLE_CONTENT=false

# --- Tests only ---
# Dedicated test database; must differ from DATABASE_URL
TEST_DATABASE_URL=postgres://portfolio_user:change-me@localhost:5432/portfolio_test
